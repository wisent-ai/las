{
  "schema_version": 1,
  "product": "las",
  "releases": true,
  "version_source": {
    "kind": "json",
    "path": "package.json",
    "pointer": "/version"
  },
  "platforms": {
    "npm-package": {
      "runner_platform": "linux-amd64",
      "quality": [],
      "build": {
        "argv": ["bash", "release/build-package.sh"]
      },
      "stage": {
        "dist/las.tgz": "las.tgz",
        "dist/las.tgz.sha256": "las.tgz.sha256"
      }
    }
  },
  "promotion": {
    "channels": ["candidate", "stable"],
    "reconcile": false
  },
  "deliveries": [
    {
      "name": "npm",
      "platform": "npm-package",
      "argv": ["bash", "release/deliver-npm.sh"],
      "required": true,
      "secret_env": {
        "NPM_TOKEN": "npm-registry#token"
      }
    }
  ]
}
